{
  "name": "scriptmate",
  "displayName": "ScriptMate",
  "description": "Helps execute your scripts with ease. More than just a script alias.",
  "version": "1.4.3",
  "publisher": "AnkitKaushik",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ankitkaushik24/scriptmate"
  },
  "engines": {
    "vscode": "^1.96.2"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "script",
    "terminal",
    "command",
    "alias",
    "shell"
  ],
  "qna": "https://github.com/ankitkaushik24/scriptmate/issues",
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "scriptmate.executeRegisteredScript",
        "title": "ScriptMate: Execute Registered Script..."
      }
    ],
    "configuration": {
      "title": "ScriptMate Configuration",
      "properties": {
        "scriptmate.customCommandsPath": {
          "type": "string",
          "default": "",
          "description": "Absolute path to a JSON file containing your custom ScriptMate command definitions. If not specified, defaults to VS Code's global storage. Example: /Users/me/scriptmate_commands.json or C:\\\\Users\\\\me\\\\scriptmate_commands.json."
        },
        "scriptmate.globalEnv": {
          "type": "object",
          "description": "Global environment variables to set for all executed scripts.",
          "default": {},
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "scriptmate-activitybar",
          "title": "ScriptMate",
          "icon": "$(list-ordered)"
        }
      ]
    },
    "views": {
      "scriptmate-activitybar": [
        {
          "id": "scriptmate.customCommandsView",
          "name": "My Scripts",
          "type": "webview",
          "contextualTitle": "ScriptMate"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "build-webviews": "VITE_ENTRY=sidePanel vite build && VITE_ENTRY=modal vite build && VITE_ENTRY=settings vite build",
    "compile": "npm run build-webviews && webpack",
    "dev": "npm run build-webviews && webpack --watch",
    "watch": "npm run build-webviews && webpack --watch",
    "package": "npm run build-webviews && webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test",
    "extension:vsix": "vsce package",
    "extension:publish": "vsce publish",
    "publish:open-vsx": "ovsx publish"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/vscode": "^1.96.2",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.4.2",
    "css-loader": "^7.1.2",
    "eslint": "^9.25.1",
    "ovsx": "^0.10.12",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.5.2",
    "typescript": "^5.8.3",
    "vite": "^8.0.11",
    "vue": "^3.5.34",
    "webpack": "^5.99.7",
    "webpack-cli": "^6.0.1"
  },
  "dependencies": {
    "@vscode/codicons": "^0.0.36",
    "@vscode/webview-ui-toolkit": "^1.4.0"
  },
  "icon": "icon.png"
}
